# PrismClause AI Microservice Environment Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Internal server-to-server token protecting AI operations (Phase 8C.3E)
# Keep empty for zero-config local development; set to a random token in production
INTERNAL_AI_SERVICE_TOKEN=

# Optional: Comma-separated tokens to allow zero-downtime token rotation
# INTERNAL_AI_SERVICE_TOKENS=new_token_here,old_token_here

# Optional: Explicitly toggle internal service authentication (defaults to true if token present)
# ENABLE_INTERNAL_AUTH=false

# Optional: Set to true to enforce local-only Hugging Face model loading without network calls
NLI_LOCAL_FILES_ONLY=false

# Optional: Set to false to disable CPU model pre-warming on service startup
NLI_WARMUP_ON_STARTUP=true

# Optional: Persistent directory for Chroma vector store (defaults to in-memory)
# CHROMA_PERSIST_DIRECTORY=./chroma_data
