PORT=3000
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.5-pro"
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ENABLE_GEMINI_PROVIDER=false
ENABLE_RAG=true
# Feature flag for LangGraph Q&A state machine (Phase 8B.3, default: false)
ENABLE_LANGGRAPH_QA=false
# Feature flag for Express Bearer Token authentication (Phase 8C.3B, default: false)
ENABLE_API_AUTH=false
# Expected Bearer token(s) for API authorization (comma-separated for multi-token / rotation)
# Generate a cryptographically secure token via: node scripts/generate-token.mjs
API_BEARER_TOKEN=
API_BEARER_TOKENS=
# Reverse Proxy configuration (Phase 8C.3C, default: false)
# Set to true or number of hops (e.g. 1) ONLY when behind a trusted reverse proxy (NGINX, Cloudflare, ALB)
TRUST_PROXY=false
# Tiered Rate Limiting overrides (Phase 8C.3C, optional)
# RATE_LIMIT_AI_WINDOW_MS=60000
# RATE_LIMIT_AI_MAX=10
# RATE_LIMIT_INGESTION_WINDOW_MS=900000
# RATE_LIMIT_INGESTION_MAX=25
# RATE_LIMIT_GENERAL_WINDOW_MS=900000
# RATE_LIMIT_GENERAL_MAX=100
# RATE_LIMIT_HEALTH_WINDOW_MS=60000
# RATE_LIMIT_HEALTH_MAX=60
ENABLE_PYTHON_AI_SERVICE=true
PYTHON_AI_SERVICE_URL=http://localhost:8000
PYTHON_AI_SERVICE_TIMEOUT_MS=5000
# Internal server-to-server token protecting Python AI microservice (Phase 8C.3E)
# Keep empty for zero-config local development; set to a random token in production
INTERNAL_AI_SERVICE_TOKEN=
# Chrome Extension Origin for Manifest V3 (e.g. chrome-extension://<your-extension-id>)
CHROME_EXTENSION_ORIGIN=chrome-extension://<your-32-char-extension-id>

